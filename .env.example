# LLM: any OpenAI-compatible API. Keep ONE block uncommented.

# --- GroqCloud (key from console.groq.com/keys, starts with gsk_) ---
OPENAI_API_KEY=gsk_your-groq-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
INPUT_TOKEN_PRICE=0.15
OUTPUT_TOKEN_PRICE=0.60
# Max output tokens per call. Groq's free plan counts these caps against its per-minute limits.
ANSWER_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=512

# --- Alibaba DashScope / Qwen (original project) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.7-max-2026-06-08

# --- OpenAI ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.4-mini

# Postgres (stores conversations + feedback)
POSTGRES_HOST=localhost
POSTGRES_DB=budget_assistant
POSTGRES_USER="<user>"
POSTGRES_PASSWORD="<password>"

# --- Hosting -----------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require   # hosted Postgres (Neon etc.); overrides POSTGRES_*
# HIDE_SETTINGS=true        # hide the Settings page from visitors
# APP_PASSWORD=choose-one   # ask for a password before using the app
# GRAFANA_PASSWORD=change-me
# SHOW_HISTORY=true      # sidebar list of all saved chats (default: on locally, off when HIDE_SETTINGS=true)
