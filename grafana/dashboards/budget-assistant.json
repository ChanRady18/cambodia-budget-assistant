        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Judge: % correct",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * avg((relevance = 'CORRECT')::int) AS pct FROM feedback WHERE source = 'judge' AND $__timeFilter(timestamp)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Numbers match documents",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * avg((relevance = 'OK')::int) AS pct FROM feedback WHERE source = 'number_check' AND relevance <> 'NO_NUMBERS' AND $__timeFilter(timestamp)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Users 👍",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * avg((score = 1)::int) AS pct FROM feedback WHERE source = 'user' AND $__timeFilter(timestamp)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Questions over time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp, $__interval), count(*) AS questions\nFROM conversations WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Cost over time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp, $__interval), sum(cost) AS cost\nFROM conversations WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Response time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp, $__interval), avg(response_time) AS avg_seconds, max(response_time) AS max_seconds\nFROM conversations WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Judge verdicts",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT relevance AS verdict, count(*) AS n FROM feedback\nWHERE source = 'judge' AND $__timeFilter(timestamp) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^n$/"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut"
      }
    },
    {
      "id": 11,
      "title": "Questions by budget year",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT budget_year, count(*) AS questions FROM conversations\nWHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "xField": "budget_year"
      }
    },
    {
      "id": 12,
      "title": "Tokens over time",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp, $__interval), sum(prompt_tokens) AS prompt, sum(completion_tokens) AS completion\nFROM conversations WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Recent questions",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.timestamp AS time, c.budget_year AS year, left(c.question, 80) AS question,\n       j.relevance AS judge, n.relevance AS numbers, n.explanation AS wrong_numbers,\n       u.score AS user_score, round(c.response_time::numeric, 2) AS seconds, round(c.cost::numeric, 5) AS cost\nFROM conversations c\nLEFT JOIN LATERAL (SELECT relevance FROM feedback WHERE conversation_id = c.id AND source = 'judge' ORDER BY id DESC LIMIT 1) j ON true\nLEFT JOIN LATERAL (SELECT relevance, explanation FROM feedback WHERE conversation_id = c.id AND source = 'number_check' ORDER BY id DESC LIMIT 1) n ON true\nLEFT JOIN LATERAL (SELECT score FROM feedback WHERE conversation_id = c.id AND source = 'user' ORDER BY id DESC LIMIT 1) u ON true\nWHERE $__timeFilter(c.timestamp)\nORDER BY c.timestamp DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Answers to review (judge not CORRECT, numbers mismatched, or 👎)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.timestamp AS time, c.question, c.answer, f.source, f.relevance AS verdict, f.explanation, f.score\nFROM feedback f JOIN conversations c ON c.id = f.conversation_id\nWHERE $__timeFilter(f.timestamp)\n  AND ((f.source = 'judge' AND f.relevance <> 'CORRECT')\n    OR (f.source = 'number_check' AND f.relevance = 'MISMATCH')\n    OR (f.source = 'user' AND f.score = -1))\nORDER BY f.timestamp DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Chats started",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS chats FROM chat_sessions WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "title": "Questions per chat",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 40,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(n) AS questions_per_chat FROM (\n  SELECT count(c.id) AS n FROM chat_sessions s JOIN conversations c ON c.session_id = s.id\n  WHERE $__timeFilter(s.created_at) GROUP BY s.id) t"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "title": "Recent chats",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.updated_at AS last_active, s.title, count(c.id) AS questions,\n       round(sum(c.cost)::numeric, 5) AS cost,\n       sum(CASE WHEN f.relevance = 'CORRECT' THEN 1 ELSE 0 END) AS judged_correct,\n       s.id AS session_id\nFROM chat_sessions s\nJOIN conversations c ON c.session_id = s.id\nLEFT JOIN feedback f ON f.conversation_id = c.id AND f.source = 'judge'\nWHERE $__timeFilter(s.updated_at)\nGROUP BY s.id ORDER BY s.updated_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}